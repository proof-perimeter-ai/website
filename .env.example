# --- PostHog analytics ------------------------------------------------------
# Client-side analytics init (instrumentation-client.ts) — autocapture,
# session replay, and every posthog.capture(...)/identify(...) call across the
# site. Public by design: PostHog project tokens are meant to ship in
# client-side code.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# --- HubSpot -----------------------------------------------------------------
# Service-app access token used server-side by /api/lead (lib/hubspot.ts) to
# create/update contacts. Never exposed to the browser. See:
# https://developers.hubspot.com/docs/guides/apps/private-apps/overview
HUBSPOT_ACCESS_TOKEN=

# Webhook called server-side after every successful lead form submission that
# results in a HubSpot contact create/update.
LEAD_WEBHOOK_URL=

# Prefix for the HubSpot contact record URL; the contact ID is appended in
# lib/hubspot.ts to build the final record link included in the webhook payload.
HUBSPOT_CONTACT_URL_PREFIX=

# --- Cal.com -------------------------------------------------------------
# Optional: Cal.com event link used by the /book-demo booking popup
# (e.g. "your-team/30min"). Defaults to "gaurav-bu/30min" if unset.
CAL_LINK=

# --- reCAPTCHA v3 (score-based), /book-demo lead form ------------------------
# Site key ships in the page HTML, so NEXT_PUBLIC_ is correct/expected for it.
# The secret key must never be exposed client-side. If RECAPTCHA_SECRET_KEY is
# unset, the form still works, just without bot-score verification (see
# lib/recaptcha.ts).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Site metadata -------------------------------------------------------
# Optional: canonical site URL used for SEO metadata (lib/metadata.ts).
# Defaults to "https://proofperimeter.com" if unset.
NEXT_PUBLIC_SITE_URL=

# Optional: app URL used by website "Get Started for Free" CTAs.
# Defaults to "https://app.proofperimeter.com" if unset.
NEXT_PUBLIC_APP_URL=

# NEXT_PUBLIC_VERCEL_ENV is auto-provided by Vercel at build/deploy time
# ("production" | "preview" | "development") and read in
# instrumentation-client.ts — don't set this manually, Vercel injects it.

# GA_MEASUREMENT_ID and GTM_ID (app/layout.tsx) are hardcoded constants, not
# env vars — intentionally not configurable here.
